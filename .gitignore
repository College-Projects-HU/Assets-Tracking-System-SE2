# ==========================================
# FULL STACK .GITIGNORE (React + Spring Boot)
# ==========================================

# ------------------------------------------
# 1. DEPENDENCIES & BUILD DIRECTORIES
# ------------------------------------------
# Node.js / React (Frontend)
node_modules/
dist/
dist-ssr/
build/
.npm/

# Java / Spring Boot / Maven (Backend)
target/
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------
# 2. LOGS
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# 3. ENVIRONMENT VARIABLES & SECRETS
# ------------------------------------------
# Never commit your environment variables as they contain secrets!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.keystore
*.jks

# ------------------------------------------
# 4. IDEs & EDITORS
# ------------------------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA / WebStorm
.idea/
*.iws
*.iml
*.ipr
out/

# ------------------------------------------
# 5. OS GENERATED FILES
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------
# 6. TESTING & COVERAGE
# ------------------------------------------
coverage/
.nyc_output/
